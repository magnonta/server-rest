# ============================================================================
# CONFIGURAÇÃO PERSONALIZADA DO MAKEFILE
# ============================================================================
# Copie este arquivo para .env.make e ajuste conforme necessário:
#   cp .env.make.example .env.make
#
# Variáveis definidas aqui sobrescrevem os valores padrão do Makefile
# ============================================================================

# Cluster Kubernetes
#KIND_CLUSTER_NAME=serverest-cluster
#KIND_WAIT_TIMEOUT=3m
#KIND_IMAGE=kindest/node:v1.35.0

# Namespace Kubernetes
#K8S_NAMESPACE=serverest

# URL da aplicação (usado nos testes)
#BASE_URL=http://localhost:30000

# Timeouts
#POD_READY_TIMEOUT=120s
#HPA_READY_TIMEOUT=60s
#METRICS_WAIT_TIME=30

# k6 Web Dashboard (dashboards interativos em HTML)
# true = gera dashboards HTML para cada teste em k6/results/
# false = desativa dashboards (padrão)
#K6_DASHBOARD=true

# Abrir dashboard no navegador durante a execução do k6
# true = abre http://localhost:5665 em tempo real enquanto o teste roda
# false = não abre (padrão, recomendado para CI)
#K6_DASHBOARD_OPEN=false

# Modo verbose (0 = desativado, 1 = ativado)
# Use: make bootstrap VERBOSE=1
#VERBOSE=0

# Imagem Docker do ServeRest
#NAME_IMAGE=paulogoncalvesbh/serverest
